rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true;
    }

    match /admins/{uid} {
      // A signed-in user may read only their own admin marker.
      // Admin documents should be created/edited from the Firebase Console,
      // not from the public website.
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /questions/{questionId} {
      // Questions are public content.
      allow read: if true;

      // Only an authenticated admin can manage published questions.
      allow create, update, delete: if isAdmin();
    }

    match /visitorQuestions/{questionId} {
      // A visitor can submit a pending question. Reads are private to admins.
      allow create: if request.resource.data.keys().hasOnly([
        'id', 'question', 'visitorName', 'category', 'date', 'createdAt', 'status'
      ])
      && request.resource.data.status == 'pending'
      && request.resource.data.question is string
      && request.resource.data.question.size() > 0
      && request.resource.data.question.size() <= 2000
      && request.resource.data.category is string
      && request.resource.data.category.size() > 0
      && request.resource.data.category.size() <= 100
      && request.resource.data.visitorName is string
      && request.resource.data.visitorName.size() <= 150
      && request.resource.data.id == questionId;

      allow read, update, delete: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
